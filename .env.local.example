# ===========================================
# GPT Image/Video Playground - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values:
#   cp .env.local.example .env.local
# ===========================================

# ----- OPTION 1: Standard OpenAI API -----
OPENAI_API_KEY=sk-your-openai-api-key-here

# (Optional) Custom OpenAI-compatible endpoint
# OPENAI_API_BASE_URL=https://your-custom-endpoint.com/v1

# ----- OPTION 2: Azure OpenAI Service (OpenAI-compatible endpoint) -----
# Uses OpenAI SDK with custom baseURL and api-key header
# AZURE_OPENAI_API_KEY=your-azure-api-key
# AZURE_OPENAI_ENDPOINT=https://your-gateway.com/openai/v1
# Deploy gpt-image-2.5-flare and gpt-image-2.5-sunburst at this endpoint.
# The model selected in the app controls the deployment header.

# ----- MAI Image 2.7 (default model) -----
# MAI image API base, ending in /mai/v1. Uses the same api-key unless MAI_IMAGE_API_KEY is set.
# MAI_IMAGE_ENDPOINT=https://your-gateway.com/your-foundry-resource/mai/v1
# MAI_IMAGE_API_KEY=your-azure-api-key

# (Optional) Video: base URL of one fal video model on Microsoft Foundry. Video is hidden until this is set.
# VIDEO_ENDPOINT=https://your-gateway.com/your-foundry-resource/providers/falai/v1/minimax/h3-max-turbo
# VIDEO_MODEL=Fal-MiniMax-H3-Max-Turbo

# ----- Prompt Auto-Enhance -----
# Model used to enhance prompts before image generation (Azure OpenAI text/chat model)
AZURE_OPENAI_TEXT_MODEL=gpt-chat-latest

# ----- Storage Mode -----
# Options: "fs" (filesystem, default for local) or "indexeddb" (for serverless/Vercel)
# Auto-detects Vercel and defaults to indexeddb if not set
# NEXT_PUBLIC_IMAGE_STORAGE_MODE=fs

# ----- Request log -----
# JSONL log of image requests, including prompts and client IPs. Set to "off" to disable.
# IMAGE_LOG_FILE=logs/image-generations.jsonl

# ----- Security -----
# (Optional) Require password to access the playground
# APP_PASSWORD=your-secret-password
